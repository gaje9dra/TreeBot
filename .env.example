# Public browser-visible configuration (never store secrets here)
NEXT_PUBLIC_CHAIN_ID=137
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Server-side market data. Use a trusted HTTPS provider endpoint.
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_RPC_FALLBACK_URL=
MARKET_DATA_BASE_URL=
MARKET_DATA_API_KEY=

# Durable paper ledger and worker (PostgreSQL required).
# Copy this file to .env.local and replace YOUR_PASSWORD with your local PostgreSQL password.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/Testing
TREEBOT_MARKET_PAIRS=WMATIC/USDC
TREEBOT_PAPER_STARTING_EQUITY_QUOTE=1000
TREEBOT_PAPER_MAX_NOTIONAL_QUOTE=100
TREEBOT_PAPER_POLL_MS=15000

# Trading modes: paper is the only supported mode until execution security gates pass.
TREEBOT_TRADING_MODE=paper
TREEBOT_LIVE_TRADING_ENABLED=false
TREEBOT_DEPOSITS_ENABLED=false

# Financial accounting policy. Leave unset until the canonical quote token is explicitly approved.
TREEBOT_ACCOUNTING_QUOTE_TOKEN=
TREEBOT_TRUSTED_VALUATION_SOURCES_JSON=[]

# Deposit worker settings (read-only by default; production activation is hard-disabled in this build).
TREEBOT_DEPOSIT_WATCHER_KEY=polygon-deposit-vault-1
TREEBOT_DEPOSIT_VAULT_ADDRESS=
TREEBOT_DEPOSIT_TOKENS_JSON=[]
TREEBOT_DEPOSIT_TOKEN_DECIMALS_JSON={}
TREEBOT_DEPOSIT_SENDER_MAP_JSON={}
TREEBOT_DEPOSIT_START_BLOCK=
TREEBOT_DEPOSIT_CONFIRMATIONS=64
TREEBOT_DEPOSIT_MAX_BLOCK_RANGE=100
TREEBOT_DEPOSIT_POLL_INTERVAL_MS=10000
TREEBOT_DEPOSIT_STALL_AFTER_MS=120000
TREEBOT_DEPOSIT_ALERT_WEBHOOK=
TREEBOT_DEPOSITS_OPERATOR_APPROVED=false
TREEBOT_DEPOSITS_SECURITY_REVIEWED=false
TREEBOT_DEPOSITS_NETWORK_VERIFIED=false

# Risk controls (conservative illustrative defaults; review before use)
TREEBOT_MIN_CAPITAL_POL=150
TREEBOT_GAS_RESERVE_POL=2
TREEBOT_MAX_TRADE_POL=5
TREEBOT_MAX_DAILY_LOSS_PERCENT=2
TREEBOT_MAX_DRAWDOWN_PERCENT=8
TREEBOT_MAX_SLIPPAGE_BPS=50
TREEBOT_MIN_EXPECTED_NET_RETURN_BPS=30
TREEBOT_MAX_TRADES_PER_HOUR=4
